# Chave da API da Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Configuração da Evolution API (rodando local ou em VPS)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua-chave-da-evolution
EVOLUTION_INSTANCE_NAME=vendly-teste

# Conexão com o banco de dados Postgres (o mesmo que a Evolution API já usa
# no servidor, só que num banco separado chamado "vendly").
DATABASE_URL=postgresql://vendly:SENHA_AQUI@localhost:5433/vendly

# IP fixo da impressora térmica da cozinha (deixe em branco se ainda não configurou).
# Pergunte ao seu patrão o IP configurado na impressora, ou veja no menu dela.
PRINTER_IP=

# Senha para acessar o painel de administração e a API.
# NÃO precisa preencher aqui — o próprio estabelecimento define a senha
# dele direto no painel (aba Regras, seção "Senha do painel"), na primeira
# vez que acessar. Deixe esta linha vazia.
ADMIN_PASSWORD=

PORT=3000
