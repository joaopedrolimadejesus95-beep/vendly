# Chave da API da Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Configuração da Evolution API (rodando local ou em VPS)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua-chave-da-evolution

# Conexão com o banco de dados Postgres
DATABASE_URL=postgresql://vendly:SENHA_AQUI@localhost:5433/vendly

# Chave secreta usada para assinar os tokens de login — cada empresa que
# faz login recebe um token assinado com essa chave. NUNCA compartilhe
# essa chave, e nunca troque ela depois de já ter empresas cadastradas
# (todo mundo precisaria fazer login de novo). Gere uma string aleatória
# longa, por exemplo rodando: openssl rand -hex 32
SESSION_SECRET=

# URL pública do servidor (usada para configurar o webhook automaticamente
# quando uma empresa conecta o WhatsApp pela primeira vez).
URL_PUBLICA_SERVIDOR=http://157.230.2.255:3000

# IP fixo da impressora térmica da cozinha (deixe em branco se ainda não configurou).
PRINTER_IP=

PORT=3000
